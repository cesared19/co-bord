# Password of the PostgreSQL user (required)
DB_PASSWORD=change-me
# Port where co-bord is published on the host
APP_PORT=3200
# true once co-bord is served over HTTPS
COOKIE_SECURE=false
# How long a sign-in lasts
SESSION_DAYS=7
# Largest file that can be uploaded to a board, in MB
MAX_UPLOAD_MB=500
# Largest file that can be uploaded is above; integrations below.
# Key that encrypts the credentials of integrations (SparkyTC, Confluence and Jira tokens). When empty, one is
# created in the app-data volume; set it to keep it outside the volume.
ENCRYPTION_KEY=
# To reach SparkyTC on the same server, join its Docker network (see the README):
# COMPOSE_FILE=docker-compose.yml:docker-compose.sparkytc.yml
# SPARKYTC_NETWORK=sparkytc_app-network
# Optional: lets Claude write retrospective summaries (the notes are sent to Anthropic's API)
ANTHROPIC_API_KEY=
# Optional: the address people open co-bord at, for links in Jira issues and test cases
PUBLIC_URL=
# Days an uploaded file no board uses is kept before it's deleted
UNUSED_FILES_DAYS=30
# How often card rules check SparkyTC results and Jira issues, in seconds
RULE_CHECK_SECONDS=120
